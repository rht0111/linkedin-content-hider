{
  "manifest_version": 3,
  "name": "LinkedIn Content Hider",
  "version": "0.1.0",
  "description": "Hide unwanted LinkedIn posts using built-in and custom rules.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "settings.js",
        "classifier.js",
        "linkedin-dom.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Content Hider"
  }
}
